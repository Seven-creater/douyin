#!/usr/bin/env bash
# Claude → Codex 高成本专家调用入口（窄问题专用）。
# 硬规则（用户 2026-09-13）：**任何调用前必须先获用户明确同意**——额度稀缺，常规活自己干。
# 用法: tools/ask-codex '<窄问题 prompt>'
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$ROOT"

TASK="${*:?Usage: tools/ask-codex '<task>'}"

# 安全默认：只读 sandbox（read-only），不自动批准写操作——Codex 的职责是
# 分析/审查，落码由主 Agent（Claude/GLM）验证后自己执行。
codex exec --sandbox read-only -C "$ROOT" "$TASK" < /dev/null
